# 이 파일을 복사해 이름을 .env 로 바꾸고 = 뒤에 키를 적는다. .env 는 공유하거나 git 에 올리지 말 것
# 이미 환경변수로 넣은 키가 있으면 환경변수가 우선

# 카카오 개발자 콘솔 · REST API 키
KAKAO_REST_KEY=

# 네이버 클라우드 플랫폼 · Maps(Geocoding) Application
NCP_GEO_ID=
NCP_GEO_SECRET=

# 네이버 클라우드 플랫폼 · NAVER API HUB 지역 검색 Application (지오코딩과 다른 Application일 수 있음)
NCP_HUB_ID=
NCP_HUB_SECRET=
